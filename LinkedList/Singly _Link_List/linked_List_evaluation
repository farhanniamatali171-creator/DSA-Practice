#include<iostream>
#include<stdlib.h>

struct Node
{
    int data;
    Node* next;
    Node(int v):data(v),next(nullptr){}
};
class LinkedList{

public:
    Node* head;

   LinkedList (): head(nullptr){}

   void insertAtEnd(int value){
    Node* newNode=new Node(value);
    if (head==nullptr)
    {
        head=newNode;
        return;
    }
    Node* temp=head;
    while (temp->next!=nullptr)
    {
       temp=temp->next;
    }
    temp->next=newNode;
    }

   void display(){
    Node* temp=head;
    while (temp!=nullptr)
    {
        std::cout<<temp->data<<" ";
        temp=temp->next;
    }
    std::cout<<"\n";
 }

 void printReverse(Node* node){

    if (node==nullptr)
    {
        return;
    }
    printReverse(node->next);
    std::cout<<node->data<<" ";
 }

 void displayReverse(){
    printReverse(head);
    std::cout<<"\n";

 }

 void redirect(){
    Node* prev=nullptr;
    Node* curr=head;
    Node* next;

    while (curr!=nullptr)
    {
       next = curr->next; 
       curr->next=prev;
       prev=curr;
       curr=next;

    }
    head=prev;
    
 }
   

 void removeDuplicates(){
    Node* curr=head; 
   
    Node* temp;
    
    while (curr!=nullptr && curr->next!=nullptr )
    {
    Node* runner=curr->next;
    Node* prev=curr;
        while (runner!=nullptr)
        {
           if(runner->data==curr->data){
            prev->next=runner->next;
            delete runner;
            runner=prev->next;
            
           }else{
            prev=runner;
            runner=runner->next;
           }
        }
           curr=curr->next;

    }
  }

  bool detectLoop(){
    Node* fast=head;
    Node* slow=head;
    while (fast!=nullptr && fast->next!=nullptr)
    {
        slow=slow->next;
        fast=fast->next->next;
        if (slow==fast)
        {
           return true;
        }       
    }
    return false;
    
  }

    Node* findMiddle(){

        if (head==nullptr)
        {
            return nullptr;
        }
        
     Node* fast=head;
     Node* slow=head;
        while (fast->next!=nullptr && fast->next->next!=nullptr)
        {
        slow=slow->next;
        fast=fast->next->next;
        
        return slow;
    }  
  }

  void check(){
    Node* curr=head;
    while (curr!=nullptr){
        if (curr->data % 2 == 0)
        { 
            std::cout<<"Even:  ";
           std::cout<<curr->data<<" ";
        }
        
        else if(curr->data % 2 != 0){
        std::cout<<"\n";
        std::cout<<"Odd: ";
            std::cout<<curr->data<<"\n";
        }
        curr=curr->next;
    }    
  }

  Node* reverseList(Node* h) {
    Node* prev = nullptr;
    Node* curr = h;
    while (curr != nullptr) {
        Node* next = curr->next;
        curr->next = prev;
        prev = curr;
        curr = next;
    }
    return prev;
}

  void flipHalf(){
   if (head==nullptr || head->next==nullptr)
   {
    return;
   }
   
    Node* fast=head->next;
    Node* slow=head;
   
    while (fast!=nullptr && fast->next!=nullptr){
        slow=slow->next;
        fast=fast->next->next;
        
    }
    Node* second=slow->next;
    slow->next=nullptr;

    Node* oldHead=head;
    head = reverseList(head);           
    Node* secondHalf = reverseList(second);
    oldHead->next=secondHalf;
 }

 void removeByValue(int value){
    Node* curr=head;
    while (head!=nullptr && head->data==value){
        
            Node* temp=head;
            head=head->next;
            delete temp;

    }
    curr=head;
    while (curr!=nullptr && curr->next!=nullptr)
    {
        if (curr->next->data==value)
        {
            Node* temp = curr->next;
            curr->next = temp->next;
            delete temp;
        }
        else{
             curr = curr->next;
        }       
    }
 }

 void swapNodes()
{
    if (head == nullptr || head->next == nullptr)
    {
        return;
    }

    Node* curr = head;
    head = head->next;

    Node* prev = nullptr;

    while (curr != nullptr && curr->next != nullptr)
    {
        Node* first = curr;
        Node* second = curr->next;
        Node* nextPair = second->next;

        second->next = first;
        first->next = nextPair;

        if (prev != nullptr)
        {
            prev->next = second;
        }

        prev = first;
        curr = nextPair;
    }
}


};



int main(){
    
    LinkedList list;
    list.insertAtEnd(10);
    list.insertAtEnd(20);
    list.insertAtEnd(30);   
    list.insertAtEnd(45);

    //display Orignal
    std::cout<<"Orignal List: ";
    list.display();

    //display Reverse
    std::cout<<"Orignal List: ";
    list.displayReverse();

    //Orignal list after changes
    std::cout<<"After:        ";
    list.display();

    std::cout<<"\n";

    //redirect Pointers
    std::cout<<"Redirct Pointers: ";
    list.redirect();
    list.display();
    std::cout<<"\n";

    //remove duplicates
    list.insertAtEnd(20);
    list.insertAtEnd(10);
    list.redirect();
    std::cout<<"Reduant List:  ";
    list.display();
   
    std::cout<<"Remove Duplicates: ";
    list.removeDuplicates();
    list.display();
    std::cout<<"\n";

    //Loop Detection
    std::cout<<"Loop Detection: ";
    if (list.detectLoop())
    {
       std::cout<<"Loop Detected!";
    }else{
        std::cout<<"No Loop Detected!";
    }
    std::cout<<"\n";
    std::cout<<"\n";

    //find Middle
    std::cout<<"Find Middle: ";
    Node* mid=list.findMiddle();
    if(mid!=nullptr){
        std::cout<<"Middle Found: "<<mid->data<<"\n";
    }else{
        std::cout<<"List is Empty "<<"\n";
    }
     std::cout<<"\n";
    
    //Seperate Even & Odd
    std::cout<<"Checking : even/odd \n";
    list.check();
    std::cout<<"\n";

    //Reverse each Half
    list.insertAtEnd(50);
    list.insertAtEnd(60);
    list.insertAtEnd(70);
   
    std::cout<<"Orignal List: ";
    list.display();
    std::cout<<"After Flip each Half: ";
    list.flipHalf();
    list.display();

    std::cout<<"\n";
    std::cout<<"LIST without Reduancy: ";
    list.removeDuplicates();
    list.display();
    std::cout<<"\n";

    //remove ByValue
    std::cout<<"Remove By value(45): ";
    list.removeByValue(45);
    list.display();
    std::cout<<"\n";

     //Swap Nodes
    std::cout<<"Swap Nodes: ";
    list.swapNodes();
    list.display();
    std::cout<<"\n";

    


    system("pause");
    return 0;
}
